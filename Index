<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday Kavyaa 💖</title>

<style>
:root {
  --bg: #f7f2ed;
  --soft: #ffffff;
  --accent: #e6397a;
  --text: #2b2b2b;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  overflow-x: hidden;
}

/* ===== SECTION BASE ===== */
section {
  min-height: 100vh;
  padding: 72px 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wrapper {
  width: 100%;
  max-width: 420px;
  text-align: center;
}

/* ===== SOFT 3D CARD ===== */
.card {
  background: var(--soft);
  border-radius: 26px;
  padding: 28px;
  box-shadow:
    0 10px 30px rgba(0,0,0,0.08),
    0 30px 80px rgba(0,0,0,0.06);
  transform: translateZ(0);
}

/* ===== HERO ===== */
.hero {
  background: #f2e9e4;
}

.hero h5 {
  letter-spacing: 2px;
  opacity: 0.7;
  margin-bottom: 12px;
}

.hero h1 {
  font-size: 40px;
  margin-bottom: 12px;
}

.hero span {
  color: var(--accent);
}

.hero p {
  font-size: 18px;
  opacity: 0.85;
}

/* ===== IMAGES ===== */
.card img {
  width: 100%;
  border-radius: 20px;
  margin-bottom: 18px;
}

/* ===== STORY ===== */
.story {
  background: #efe6dc;
}

.story h2 {
  font-size: 26px;
  margin-bottom: 14px;
}

.story p {
  font-size: 18px;
  line-height: 1.6;
}

/* ===== GALLERY ===== */
.gallery {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

/* ===== VIDEO ===== */
video {
  width: 100%;
  border-radius: 20px;
  margin-bottom: 18px;
}

/* ===== LETTER ===== */
.letter p {
  font-size: 18px;
  line-height: 1.7;
}

/* ===== FINAL ===== */
.final {
  background: var(--accent);
  color: white;
}

.final h1 {
  font-size: 36px;
  margin-bottom: 14px;
}

/* ===== PARALLAX FADE ===== */
.reveal {
  opacity: 0;
  transform: translateY(40px) scale(0.96);
  transition: all 1s ease;
}

.reveal.show {
  opacity: 1;
  transform: translateY(0) scale(1);
}

/* ===== SUBTLE DEPTH ===== */
.depth-1 { transform: translateZ(10px); }
.depth-2 { transform: translateZ(20px); }
.depth-3 { transform: translateZ(30px); }
</style>
</head>

<body>

<!-- HERO -->
<section class="hero">
  <div class="wrapper reveal">
    <div class="card depth-2">
      <h5>Hi Kavyaa,</h5>
      <h1>Happy Birthday <span>💖</span></h1>
      <p>This little space is made just for you.</p>
    </div>
  </div>
</section>

<!-- IMAGE 1 -->
<section>
  <div class="wrapper reveal">
    <div class="card depth-3">
      <img src="media/p1.jpg">
      <p>Every moment with you feels special.</p>
    </div>
  </div>
</section>

<!-- IMAGE 2 -->
<section>
  <div class="wrapper reveal">
    <div class="card depth-3">
      <img src="media/p2.jpg">
      <p>Your smile is my favorite sight.</p>
    </div>
  </div>
</section>

<!-- STORY -->
<section class="story">
  <div class="wrapper reveal">
    <div class="card depth-2">
      <h2>How Everything Started</h2>
      <p>
        From small conversations to meaningful moments,  
        I never imagined how important you would become to me.
      </p>
    </div>
  </div>
</section>

<!-- GALLERY -->
<section>
  <div class="wrapper reveal">
    <div class="card gallery depth-3">
      <img src="media/p3.jpg">
      <img src="media/p4.jpg">
    </div>
  </div>
</section>

<!-- VIDEO -->
<section>
  <div class="wrapper reveal">
    <div class="card depth-2">
      <video controls playsinline>
        <source src="media/v1.mp4" type="video/mp4">
      </video>
      <p>A memory I’ll always keep close.</p>
    </div>
  </div>
</section>

<!-- LETTER -->
<section>
  <div class="wrapper reveal">
    <div class="card depth-2 letter">
      <h2>Dear Kavyaa 💌</h2>
      <p>
        On your birthday, I just want you to know  
        how grateful I am for you.  
        You bring warmth, calm, and happiness into my life.
      </p>
    </div>
  </div>
</section>

<!-- FINAL -->
<section class="final">
  <div class="wrapper reveal">
    <div class="card depth-1">
      <h1>Always You 💍</h1>
      <p>
        No matter where life takes us,  
        I hope I always get to walk beside you.
      </p>
    </div>
  </div>
</section>

<script>
/* SCROLL-BASED PARALLAX REVEAL */
const items = document.querySelectorAll(".reveal");

const observer = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add("show");
    }
  });
}, { threshold: 0.15 });

items.forEach(item => observer.observe(item));
</script>

</body>
</html>
